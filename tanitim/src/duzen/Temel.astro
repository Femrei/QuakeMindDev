---
import '@/stil/site.css'
import { tr } from '@/icerik/tr'

type Props = { baslik?: string; aciklama?: string }
const { baslik, aciklama } = Astro.props
const sayfaBasligi = baslik ?? tr.site.unvan
const sayfaAciklamasi = aciklama ?? tr.site.aciklama
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{sayfaBasligi}</title>
    <meta name="description" content={sayfaAciklamasi} />
    <meta property="og:title" content={sayfaBasligi} />
    <meta property="og:description" content={sayfaAciklamasi} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-ground text-ink">
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-20 focus:rounded-control focus:border focus:border-line-2 focus:bg-panel focus:px-3 focus:py-2 focus:text-body"
    >
      İçeriğe geç
    </a>
    <slot />
  </body>
</html>
